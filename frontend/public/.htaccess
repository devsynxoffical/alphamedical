# Apache config for the prerendered Alpha Medi Assist site.
# Every page exists as a static file: /about-us -> /about-us.html
Options -MultiViews -Indexes
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Canonical host: https://alphamediassist.com (no www). Google indexes this
  # host and it is the verified Search Console property.
  RewriteCond %{HTTP_HOST} ^www\.alphamediassist\.com$ [NC]
  RewriteRule ^ https://alphamediassist.com%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} ^alphamediassist\.com$ [NC]
  RewriteRule ^ https://alphamediassist.com%{REQUEST_URI} [R=301,L]

  # Old site was compromised (injected casino/spam pages were indexed by Google).
  # Tell crawlers those URLs are gone for good (410) so they drop out faster.
  RewriteRule ^[0-9]{6,12}/?$ - [G,L]
  RewriteRule ^[a-z]+[0-9]{6,}\.html$ - [G,L]
  RewriteRule ^(boyslove|books|cd|dozin|pcsp|vintagegame|pages)\.(html|php)$ - [G,L]
  RewriteRule ^(items|shopdetail|cargo|man|product_archives|order|cart|events)(/.*)?$ - [G,L]
  RewriteRule ^uncategorized/(entdecken-sie|stargames|william-hill)[^/]*/?$ - [G,L]
  # Old tag pages that had impressions -> the article that now covers the topic
  RewriteRule ^tag/(icn-meaning|icn-stands-for|icn-number-meaning|icn-in-medical-billing|what-does-dcn-stand-for|dcn-medical|void-meaning-medical|what-does-void-mean-in-medical-terms|what-is-void-claim-in-medical-billing)/?$ /blog/what-is-void-claim-in-medical-billing [R=301,L]
  RewriteRule ^tag/(recoupment-meaning-in-medical-billing|what-is-a-recoupment|reversal-and-recoupment-in-medical-billing|meaning-of-offset-in-medical-billing|common-causes-of-offset-in-medical-billing|how-offset-works-in-medical-billing|offset-payment-meaning|example-of-offset-in-medical-billing)/?$ /blog/difference-between-reversal-and-recoupment-in-medical-billing [R=301,L]
  RewriteRule ^tag/(what-is-a-claim-reversal|can-an-insurance-company-make-you-pay-back-money|how-far-back-can-an-insurance-company-recoup-a-payment)/?$ /blog/can-an-health-insurance-company-reverse-a-paid-claim [R=301,L]
  RewriteRule ^tag/.*$ - [G,L]

  # Old "specialities" spelling -> /specialties/...
  RewriteRule ^specialities/([a-z-]+)/?$ /specialties/$1 [R=301,L]

  # Lead form endpoint (PHP on this host)
  RewriteRule ^api/form-submission/?$ api/form-submission.php [L,QSA]

  # 301 redirects for old / duplicate URLs (generated from src/seo/routes.ts)
# @@REDIRECTS@@

  # /index.html -> /   and   /page.html -> /page   (one URL per page)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?]
  RewriteCond %1 !^404$
  RewriteRule ^ /%1 [R=301,L]

  # Remove trailing slash: /about-us/ -> /about-us
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Serve the prerendered file for clean URLs
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Hashed build assets never change -> cache for a year
  <FilesMatch "^.*-[A-Za-z0-9_-]{8}\.(js|css|png|jpe?g|webp|gif|svg|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML / sitemap / llms.txt must always be revalidated so updates show up
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

AddType text/plain .txt
AddCharset utf-8 .txt .html .xml
