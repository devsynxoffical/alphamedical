# Apache config for the prerendered Alpha Medi Assist site.
# Every page exists as a static file: /about-us -> /about-us.html
Options -MultiViews -Indexes
DirectoryIndex index.html
DirectorySlash Off
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Force HTTPS + www (canonical host). Uncomment once you have confirmed
  # that both http:// and the bare domain point at this server.
  # RewriteCond %{HTTPS} off [OR]
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteRule ^ https://www.alphamediassist.com%{REQUEST_URI} [R=301,L]

  # 301 redirects for old / duplicate URLs (generated from src/seo/routes.ts)
# @@REDIRECTS@@

  # /index.html -> /   and   /page.html -> /page   (one URL per page)
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/([^\s?]+)\.html[\s?]
  RewriteCond %1 !^404$
  RewriteRule ^ /%1 [R=301,L]

  # Remove trailing slash: /about-us/ -> /about-us
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Serve the prerendered file for clean URLs
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+)$ $1.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  # Hashed build assets never change -> cache for a year
  <FilesMatch "^.*-[A-Za-z0-9_-]{8}\.(js|css|png|jpe?g|webp|gif|svg|mp4|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # HTML / sitemap / llms.txt must always be revalidated so updates show up
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

AddType text/plain .txt
AddCharset utf-8 .txt .html .xml
